# ---- App ----
NODE_ENV=development
PORT=5000
# Comma-separated list of allowed browser origins (the Next.js client)
CLIENT_URL=http://localhost:3000

# ---- Supabase Postgres (Prisma) ----
# Transaction-mode pooler URL (IPv4-friendly), from Supabase → Settings → Database
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# Session-mode pooler URL, used only by `prisma migrate`
DIRECT_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# ---- Supabase Storage (PDF files) ----
# Supabase → Settings → API. Create a PRIVATE bucket named "documents" first (see README).
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>
SUPABASE_STORAGE_BUCKET=documents

# ---- Upstash Redis (queue + rate limiting) ----
UPSTASH_REDIS_URL=rediss://default:<password>@<host>:6379

# ---- Google Gemini ----
GEMINI_API_KEY=<api-key>
# Must produce 3072-dim vectors to match the pgvector column
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
GEMINI_CHAT_MODEL=gemini-2.0-flash
GROQ_API_KEY=gsk_<api-key>
GROQ_CHAT_MODEL=llama-3.3-70b-versatile

# ---- Clerk ----
CLERK_PUBLISHABLE_KEY=pk_<publishable-key>
CLERK_SECRET_KEY=sk_<secret-key>

# ---- Tunables (defaults shown) ----
MAX_FILE_SIZE_MB=20
MAX_CHUNKS_PER_DOCUMENT=4000
WORKER_CONCURRENCY=2
TOP_K_CHUNKS=8
HYBRID_SEARCH_ENABLED=true
RRF_K=60
RATE_LIMIT_UPLOAD_PER_HOUR=10
RATE_LIMIT_CHAT_PER_MIN=20
