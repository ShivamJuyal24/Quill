{
  "name": "ai-chat-pdf-server",
  "version": "1.0.0",
  "description": "Production API for the AI Chat PDF RAG app — Clerk auth, Supabase Postgres + Storage (pgvector), Upstash Redis (BullMQ), Gemini embeddings & chat.",
  "type": "module",
  "main": "index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "nodemon --signal SIGTERM index.js",
    "dev:worker": "nodemon worker.js",
    "start": "node index.js",
    "start:worker": "node worker.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "postinstall": "prisma generate",
    "test": "vitest run"
  },
  "prisma": {
    "schema": "src/prisma/schema.prisma"
  },
  "dependencies": {
    "@clerk/express": "^2.1.69",
    "@google/generative-ai": "^0.24.0",
    "@prisma/client": "^6.19.3",
    "@supabase/supabase-js": "^2.45.0",
    "bullmq": "^5.73.2",
    "cohere-ai": "^8.3.0",
    "cors": "^2.8.5",
    "dotenv": "^17.0.0",
    "express": "^5.2.1",
    "helmet": "^8.1.0",
    "ioredis": "^5.10.1",
    "morgan": "^1.10.1",
    "multer": "^2.0.2",
    "pdf-parse": "^2.4.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.14",
    "prisma": "^6.19.3",
    "vitest": "^5.0.5"
  },
  "keywords": [
    "rag",
    "pdf",
    "embeddings",
    "pgvector",
    "supabase",
    "upstash",
    "bullmq",
    "gemini",
    "clerk"
  ],
  "license": "MIT"
}
